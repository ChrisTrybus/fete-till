# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# Leave empty to run in local-only mode (no sync).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Card payments through the SumUp app. Make an affiliate key in a SumUp account under
# Settings > For developers > Affiliate Keys, for the app id com.fetetill.app.
# Leave empty and the Card button just records card sales taken some other way.
EXPO_PUBLIC_SUMUP_AFFILIATE_KEY=

# Cash Tin accounts. Turn on Email/Password, Google and Apple under Firebase console >
# Authentication > Sign-in method. Google sign-in needs these OAuth client ids from
# Google Cloud console > APIs & Services > Credentials, in the Firebase project:
#   web: the "Web client (auto created by Google Service)" one. Needed on Android and iOS.
#   iOS: an iOS client for the bundle id com.fetetill.app. Leave empty and iOS doesn't offer Google.
# Android also needs an Android client for com.fetetill.app with the SHA-1 of the build's
# signing key (npx eas-cli@latest credentials shows it). Google sign-in isn't in Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
