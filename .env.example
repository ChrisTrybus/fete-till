# Copy to .env and fill in from Firebase console > Project settings > Your apps > Web app.
# Leave empty to run in local-only mode (no sync).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Card payments through the SumUp app. Make an affiliate key in a SumUp account under
# Settings > For developers > Affiliate Keys, for the app id com.fetetill.app.
# Leave empty and the Card button just records card sales taken some other way.
EXPO_PUBLIC_SUMUP_AFFILIATE_KEY=
