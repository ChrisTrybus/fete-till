rules_version = '2';

// Shared events are made by the server (startSharedEvent in functions/), which
// can require and spend an event pack credit. So devices can't create events,
// join codes or organiser codes here.
//
// Every device signs in anonymously. Access to an event comes from knowing its
// join code: a device becomes a member by writing members/{its uid} with a code
// that maps to that event. Members can read the event and add sales to it.
//
// Organisers are the devices that know the event's organiser code, which is
// made when the event is created and kept where no device can read it back.
// A device becomes an organiser by writing organisers/{its uid} with that code.
// Only organisers can change the price list or void another till's sales.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isMember(eventId) {
      return signedIn()
        && exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid));
    }
    function isOrganiser(eventId) {
      return signedIn()
        && exists(/databases/$(database)/documents/events/$(eventId)/organisers/$(request.auth.uid));
    }

    // Join codes. Single lookups only (no listing), so codes can't be enumerated.
    // Codes are made by the server with the event, and never changed.
    match /codes/{code} {
      allow get: if signedIn();
    }

    match /events/{eventId} {
      allow get: if isMember(eventId)
        || (signedIn() && resource.data.createdBy == request.auth.uid);
      // Organisers may edit the name and price list, and close or reopen the event
      // (closedAt). createdBy, code, and the account that paid are fixed. Closing is a signal to
      // the tills to stop selling. Sales are still accepted afterwards, so that a
      // till with no signal at closing time doesn't lose what it took.
      allow update: if isOrganiser(eventId)
        && (request.resource.data.get('closedAt', null) == null || request.resource.data.closedAt is int)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.code == resource.data.code
        && request.resource.data.get('account', null) == resource.data.get('account', null)
        && request.resource.data.get('paid', null) == resource.data.get('paid', null)
        && request.resource.data.items.size() <= 200;

      match /members/{uid} {
        allow read: if isMember(eventId);
        // A member doc also carries the till's opening float (whole pence), which
        // the other tills add to its cash sales to say what its tin should hold.
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.tillName is string
          && (!('float' in request.resource.data)
            || (request.resource.data.float is int && request.resource.data.float >= 0))
          && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.eventId == eventId;
      }

      // The organiser code is in private/organiser. The server writes it with the
      // event, and no device can read or change it: it is only ever compared
      // against, below. With no rule here, everything else is refused.

      // A device claims the organiser role by presenting the organiser code.
      // Each device can read only its own claim, so the code doesn't leak.
      match /organisers/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.code
            == get(/databases/$(database)/documents/events/$(eventId)/private/organiser).data.code;
      }

      // Sales can be added and voided, never edited or deleted. A till can void
      // or restore its own sales; an organiser can do so for any till.
      match /sales/{saleId} {
        allow read: if isMember(eventId);
        allow create: if isMember(eventId)
          && request.resource.data.id == saleId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.total is int
          && request.resource.data.total >= 0
          && request.resource.data.at is int
          && request.resource.data.at >= 0
          && request.resource.data.at <= 8640000000000000
          && request.resource.data.tendered is int
          && request.resource.data.tendered >= 0
          && request.resource.data.method in ['cash', 'card']
          && request.resource.data.tillName is string
          && request.resource.data.deviceId is string
          && request.resource.data.voided is bool
          && request.resource.data.get('cardRef', '') is string
          && request.resource.data.get('cardUnconfirmed', false) is bool
          && request.resource.data.lines is list
          && request.resource.data.lines.size() <= 100;
        allow update: if isMember(eventId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'voidedAt'])
          && request.resource.data.voided is bool
          && request.resource.data.get('voidedAt', 0) is int
          && (resource.data.createdBy == request.auth.uid || isOrganiser(eventId));
      }

      // Gift Aid declarations hold a donor's name and home address. Any till can
      // submit one through submitGiftAid; only organisers can read them back.
      // The callable verifies sale ownership and calculates the donation amount.
      match /giftAid/{saleId} {
        allow read: if isOrganiser(eventId);
      }
    }

    // Cash Tin accounts: event pack credits, and the packs bought and spent. Only
    // the server writes these. An account can read its own, signed in on the
    // account Auth (never a phone's anonymous event user).
    function isAccount(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    match /accounts/{uid} {
      allow get: if isAccount(uid);
      match /{sub}/{docId} {
        allow read: if isAccount(uid);
      }
    }
  }
}
